// Pulseboard's own tables (clone-owned). A product is an org; every row carries orgId.
// Hot-path reads and writes are raw SQL (src/lib/ingest.ts); these models own the schema and migrations.

model WriteKey {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @db.Uuid
  org       Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  keyHash   String    @unique // sha256 of the key; the raw key is never stored (INV-07)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)

  @@index([orgId])
}

model Event {
  id         BigInt   @id @default(autoincrement())
  orgId      String   @db.Uuid
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventId    String? // client-supplied dedupe key; NULLs never conflict
  eventName  String
  userId     String
  ts         DateTime @db.Timestamptz(6) // client time, future values clamped to receivedAt
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
  properties Json     @default("{}")

  @@unique([orgId, eventId])
  @@index([orgId, ts]) // rollup day recompute (and funnels, Phase 3)
  @@index([orgId, receivedAt]) // rollup dirty-day scan (D-008)
  @@index([orgId, userId, eventName, ts, id]) // funnel next-step seek (D-017)
}

model DeadLetterEvent {
  id         BigInt   @id @default(autoincrement())
  orgId      String   @db.Uuid
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payload    Json
  reason     String
  receivedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([orgId, receivedAt])
}

// Rollups (src/lib/rollups.ts). Days are UTC. Rebuilt per dirty day by DELETE + INSERT … SELECT, so a re-run is exact.
model RollupDaily {
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  eventName String
  count     Int
  uniques   Int

  @@id([orgId, day, eventName])
}

model RollupDailyProp {
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  eventName String
  prop      String
  value     String // properties->>prop, truncated to 200 chars so the key fits a btree entry
  count     Int

  @@id([orgId, day, eventName, prop, value])
}

// Which property values get rolled up. eventName null = every event.
model RegisteredProperty {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @db.Uuid
  org       Org     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  eventName String?
  prop      String

  @@unique([orgId, eventName, prop])
}

// Max Event.receivedAt the last rollup run saw, per org. Its row lock also serializes concurrent runs.
model RollupWatermark {
  orgId      String   @id @db.Uuid
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  receivedAt DateTime @db.Timestamptz(6)
  ranAt      DateTime @db.Timestamptz(6)
}

// One row per (day, event, user) with at least one event: retention's source (D-015). Rebuilt with the day, like RollupDaily.
model RollupUserDay {
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  eventName String
  userId    String

  @@id([orgId, day, eventName, userId])
}
